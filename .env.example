# Database connection string
# For local development with the setup script defaults:
DATABASE_URL=postgresql://komatsu:komatsu_dev_2024@127.0.0.1:5432/komatsu_dev

# App URL (keep http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Session secret — generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=local-dev-secret-change-in-production

# Directory for file uploads
UPLOAD_DIR=./uploads

